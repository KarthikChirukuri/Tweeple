<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create New Post</title>

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #15202b;
      color: #fff;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      min-height: 100vh;
    }

    .container {
      background-color: #192734;
      border-radius: 20px;
      width: 90%;
      max-width: 600px;
      padding: 25px;
      margin-top: 50px;
      box-shadow: 0 0 10px rgba(29, 161, 242, 0.3);
    }

    h2 {
      text-align: center;
      color: #1da1f2;
      font-size: 22px;
      margin-bottom: 25px;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    label {
      font-weight: 500;
      font-size: 15px;
      color: #ccc;
    }

    input[type="text"],
    textarea {
      background-color: #22303c;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 12px;
      font-size: 15px;
      width: 95%;
      outline: none;
      resize: none;
    }

    input[type="text"]:focus,
    textarea:focus {
      border: 1px solid #1da1f2;
      background-color: #192734;
    }

    h3 {
      font-size: 16px;
      font-weight: 500;
      color: #ddd;
    }

    button {
      background-color: #1da1f2;
      width: 25%;
      color: white;
      border: none;
      padding: 12px;
      border-radius: 25px;
      cursor: pointer;
      font-size: 16px;
      font-weight: 600;
      transition: 0.3s ease;
    }

    button:hover {
      background-color: #095a8d;
    }

    .back-link {
      text-align: center;
      display: block;
      margin-top: 15px;
      color: #1da1f2;
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 600px) {
      .container {
        margin-top: 20px;
        padding: 15px;
        border-radius: 15px;
      }

      h2 {
        font-size: 20px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>Create your new post</h2>

    <form method="post" action="/posting">
      <% if (typeof title !== 'undefined' && title) { %>
        <input type="hidden" name="title" value="<%= title %>">
        <h3>Title: <%= title %></h3>
      <% } else { %>
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" placeholder="Enter a title..." required>
      <% } %>

      <label for="content">What's on your mind?</label>
      <textarea id="content" name="content" rows="8" placeholder="Write something..." required></textarea>

      <button type="submit">Tweet</button>
    </form>

    <a href="/" class="back-link">← Back to Home</a>
  </div>
</body>
</html>
