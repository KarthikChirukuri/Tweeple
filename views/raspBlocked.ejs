<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Blocked — Node Security Shield</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --bg: #0f1720;
      --card: #0f1b24;
      --accent: #1da1f2;
      --muted: #9aa8b3;
      --danger: #ff6b6b;
    }
    body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--bg); color:#fff; font-family:Inter,system-ui,Arial; }
    .card { width:calc(100% - 40px); max-width:680px; background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.05)); border-radius:14px; padding:28px; box-shadow:0 10px 40px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.03); }
    .top { display:flex; gap:16px; align-items:center; }
    .shield { background:var(--danger); color:#fff; width:72px; height:72px; display:flex; align-items:center; justify-content:center; border-radius:12px; font-size:28px; }
    h1 { margin:0; font-size:20px; color:var(--accent); }
    p.lead { margin:10px 0 20px; color:var(--muted); }
    .details { display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-top:6px; }
    .meta { background:rgba(255,255,255,0.02); padding:12px; border-radius:8px; font-size:13px; color:var(--muted); }
    code.snip { display:block; background:#071018; padding:12px; border-radius:8px; margin-top:8px; color:#d1f0ff; font-size:13px; overflow:auto; max-height:120px; }
    .actions { margin-top:18px; display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
    a.btn { display:inline-block; padding:10px 16px; border-radius:8px; text-decoration:none; font-weight:600; color:#000; background:var(--accent); }
    button.ghost { background:transparent; border:1px solid rgba(255,255,255,0.06); color:var(--muted); padding:10px 14px; border-radius:8px; cursor:pointer;}
    .hint { margin-top:14px; color:var(--muted); font-size:13px; }
    .small { font-size:12px; color:#a6b6bf; margin-top:8px; }
    @media (max-width:600px){ .details { grid-template-columns: 1fr; } .top{flex-direction:column; align-items:flex-start} }
  </style>
</head>
<body>
  <div class="card" role="alert">
    <div class="top">
      <div class="shield"><i class="fa-solid fa-shield-halved"></i></div>
      <div style="flex:1">
        <h1>Blocked by Node Security Shield</h1>
        <p class="lead">We detected suspicious content and blocked this request to protect the application and user data.</p>
      </div>
      <div style="text-align:right">
        <div class="small">Incident ID</div>
        <div style="font-weight:700; margin-top:6px;"><%= incidentId %></div>
      </div>
    </div>

    <div class="details" style="margin-top:18px;">
      <div class="meta">
        <strong>Attack type</strong><br>
        <div style="margin-top:6px;"><%= rule %></div>
      </div>

      <div class="meta">
        <strong>Short reason</strong><br>
        <div style="margin-top:6px;"><%= message %></div>
      </div>

      <div class="meta">
        <strong>Detected at</strong><br>
        <div style="margin-top:6px;"><%= new Date(time).toLocaleString() %></div>
      </div>

      <div class="meta">
        <strong>Request IP</strong><br>
        <div style="margin-top:6px;"><%= ip %></div>
      </div>
    </div>

    <div style="margin-top:14px;">
      <strong>Payload snippet (masked)</strong>
      <code class="snip"><%= payloadSnippet %></code>
    </div>

    <div class="actions">
      <a class="btn" href="/">Return Home</a>

      <!-- Report false positive: sends a form POST (you can implement route) -->
      <form method="post" action="/report-incident" style="display:inline;">
        <input type="hidden" name="incidentId" value="<%= incidentId %>">
        <button type="submit" class="ghost">Report false positive</button>
      </form>

      <button class="ghost" onclick="showTips()">How to avoid</button>
    </div>

    <div class="hint" id="tips" style="display:none;">
      <strong>Quick tips:</strong>
      <ul style="margin:8px 0 0 18px; color:#9fb7c1">
        <li>Remove unexpected shell characters like backticks or pipe operators.</li>
        <li>Avoid words that resemble SQL patterns in form fields if not needed.</li>
        <li>Use the app input fields as plain text; if you need special characters, try escaping them.</li>
      </ul>
    </div>

    <div class="small">If you think this was blocked in error, report it using the button above. Incident id helps admins investigate.</div>
  </div>

  <script>
    function showTips(){ const el = document.getElementById('tips'); el.style.display = el.style.display === 'none' ? 'block' : 'none'; }
  </script>
</body>
</html>
